{"nodes": [{"id": "docs_epic_28_profile_training", "label": "EPIC-28: Cross-Session Profile Training", "file_type": "document", "source_file": "docs/EPIC-28_Profile_Training.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epic_28_profile_training_cma_es", "label": "CMA-ES Optimisation", "file_type": "rationale", "source_file": "docs/EPIC-28_Profile_Training.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over regret-matching (designed for discrete normal-form games) and simple (1+lambda)-ES (slower convergence, no covariance structure) because the problem is ~16-dimensional continuous optimisation with noisy fitness and no analytic gradient; the cmaes crate is actively maintained."}, {"id": "docs_epic_28_profile_training_bb100_fitness", "label": "BB/100 Fitness Signal", "file_type": "concept", "source_file": "docs/EPIC-28_Profile_Training.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epic_28_profile_training_paired_seeds", "label": "Paired-Seed Variance Reduction", "file_type": "rationale", "source_file": "docs/EPIC-28_Profile_Training.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Poker simulation fitness is extremely noisy (\u00b1500 BB/100 per 1,000-hand session). Same RNG seeds across all candidates within a generation make relative ranking reliable; K replicates with different seed batches per generation prevent overfitting to one seed. Static opponent field chosen over co-evolution to limit variance and complexity."}], "edges": [{"source": "docs_epic_28_profile_training", "target": "docs_tutorial_epic28_es_math", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/EPIC-28_Profile_Training.md", "source_location": n