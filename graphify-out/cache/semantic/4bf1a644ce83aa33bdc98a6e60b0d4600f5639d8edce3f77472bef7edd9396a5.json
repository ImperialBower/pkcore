{"nodes": [{"id": "docs_release_0_0_53", "label": "pkcore 0.0.53 Release Notes", "file_type": "document", "source_file": "docs/RELEASE_0.0.53.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_release_0_0_53_set_blinds_deferral", "label": "PokerSession set_blinds Deferred Blind Changes", "file_type": "rationale", "source_file": "docs/RELEASE_0.0.53.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct mutation of session.table.forced mid-hand rebased min_raise() against the new BB (rejecting legal raises with InsufficientIncrement) and recorded stakes that mismatched actual blind posts, breaking YAML replay. set_blinds() defers changes until the in-flight hand ends; forced_at_hand_start() snapshots the blinds at start_hand so serializers record stakes matching the actual posts. Also dropped the processed_chip_levels skip-set (distinct layers can share a numeric chip value after side-pot subtraction) in favor of a main_pot_paid toggle."}], "edges": [{"source": "docs_release_0_0_53", "target": "docs_release_0_0_53_set_blinds_deferral", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE_0.0.53.md", "source_location": null, "weight": 1.0}, {"source": "docs_release_0_0_53_set_blinds_deferral", "target": "casino_session_pokersession", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE_0.0.53.md", "source_location": "set_blinds / forced_at_hand_start", "weight": 1.0}, {"source": "docs_release_0_0_53", "target": "table_showdown_showdown", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE_0.0.53.md", "source_location": "processed_chip_levels -> main_pot_paid in process_multiway", "weight": 1.0}, {"source": "docs_release_0_0_53", "target": "casino_table_no_cell_ta