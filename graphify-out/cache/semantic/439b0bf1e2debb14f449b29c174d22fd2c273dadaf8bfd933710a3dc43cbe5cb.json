{"nodes": [{"id": "docs_epic_16_dcfr", "label": "EPIC-16: CFR+ and Discounted CFR", "file_type": "document", "source_file": "docs/EPIC-16_DCFR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epic_16_dcfr_cfr_plus", "label": "CFR+ Algorithm", "file_type": "concept", "source_file": "docs/EPIC-16_DCFR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two changes over vanilla CFR: regret floor (clamp accumulated regret to max(0, value), discarding stale negative regret) and linear strategy weighting (iteration t weighted by t), down-weighting chaotic early iterations automatically."}, {"id": "docs_epic_16_dcfr_dcfr", "label": "Discounted CFR (DCFR)", "file_type": "concept", "source_file": "docs/EPIC-16_DCFR.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generalizes CFR+ with alpha-discounted regrets (factor t^a/(t^a+1)) and beta-discounted strategy sums. Recommended alpha=1.5, beta=0; converges 2-10x faster than vanilla CFR on typical poker spots with no extra per-iteration cost. Chosen as the default CfrVariant."}, {"id": "docs_epic_16_dcfr_tammelin_2014", "label": "Tammelin 2014 (CFR+ paper)", "file_type": "paper", "source_file": "docs/EPIC-16_DCFR.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Tammelin", "contributor": null}, {"id": "docs_epic_16_dcfr_brown_sandholm_2019", "label": "Brown & Sandholm 2019 (DCFR paper)", "file_type": "paper", "source_file": "docs/EPIC-16_DCFR.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Brown & Sandholm", "contributor": null}], "edges": [{"source": "docs_epic_16_dcfr", "target": "docs_epic_15_gto_solver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/EPIC-16_DCFR.md", "source_location": null, "we