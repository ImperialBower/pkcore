{"nodes": [{"id": "docs_epic_27_exploitative_decider", "label": "EPIC-27: ExploitativeDecider Layer", "file_type": "document", "source_file": "docs/EPIC-27_Exploitative_Decider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epic_27_exploitative_decider_wrapper_pattern", "label": "Exploitation-as-Wrapper Pattern", "file_type": "rationale", "source_file": "docs/EPIC-27_Exploitative_Decider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rather than fork RuleBasedDecider into an exploitative twin, exploitation is a modifier: a decider wrapping any inner BotDecider that adjusts the BotProfile from opponent stats at decision time, then forwards. Composable (any decider gains exploitation for free), zero trait churn, unit-testable as a pure function; cost is one small BotProfile clone per decision."}, {"id": "docs_epic_27_exploitative_decider_epic_28_training", "label": "EPIC-28 Sketch: Cross-Session Profile Training", "file_type": "concept", "source_file": "docs/EPIC-27_Exploitative_Decider.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Follow-on: tune ExploitConfig's ~20 bounded scalars (multipliers, thresholds, sample gates) against a static field of bot profiles via CMA-ES or regret-matching, scoring runs by chip delta / BB/100, persisting trained configs as YAML. Reuses SimTable::run_n_hands and the CFR/DCFR regret primitives."}], "edges": [{"source": "docs_epic_27_exploitative_decider", "target": "docs_epic_26_player_stats", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/EPIC-27_Exploitative_Decider.md", "source_location": null, "weight": 1.0}, {"source": "docs_epic_27_exploitative_decider", "target": "bot_exploitative_decider_exploitativedecider", "relation": "references", "confidence": "EXTRAC