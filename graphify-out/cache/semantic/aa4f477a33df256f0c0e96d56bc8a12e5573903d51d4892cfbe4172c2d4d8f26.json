{"nodes": [{"id": "docs_refactor_process_multiway", "label": "Refactor: process_multiway PotManager to TableEquity", "file_type": "document", "source_file": "docs/REFACTOR_process_multiway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_refactor_process_multiway_potmanager_to_tableequity", "label": "process_multiway Refactor: PotManager to TableEquity", "file_type": "rationale", "source_file": "docs/REFACTOR_process_multiway.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old PotManager silently skipped side pots when no overall winner was eligible (chips lost) and ignored folded players' contributions. TableEquity was already the canonical per-seat commitment representation (folded chips tracked as Seatbit::NONE, equal levels consolidated), and its winnings() method computes a winner's claimable chips and returns the leftover side pot. Key insight: chips_in_play persists across streets (only cleared by act_close_it_out), so determine_hand_equity() can be captured before close_it_out(). CaseEval is indexed by seat number because HoleCards::from(seats) iterates all seats in order."}], "edges": [{"source": "docs_refactor_process_multiway", "target": "docs_refactor_process_multiway_potmanager_to_tableequity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/REFACTOR_process_multiway.md", "source_location": null, "weight": 1.0}, {"source": "docs_refactor_process_multiway_potmanager_to_tableequity", "target": "table_showdown_showdown", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/REFACTOR_process_multiway.md", "source_location": "src/casino/table/showdown.rs process_multiway", "weight": 1.0}, {"source": "table_showdown_showdown", "target": "seats_table_equity_tableequity", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/REFACTOR_process_multiway.md", "source_location": "equity.winnings(winner_seatbit)", "weight": 1.0}, {"source": "table_showdown_showdown", "target": "analysis_case_eval_caseeval", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/REFACTOR_process_multiway.md", "source_location": "case_eval.winning_seats(), case_eval.get(seat)", "weight": 1.0}], "hyperedges": [{"id": "showdown_pot_distribution_pipeline", "label": "Showdown Pot Distribution Pipeline", "nodes": ["casino_table_no_cell_tablenocell", "table_showdown_showdown", "seats_table_equity_tableequity", "analysis_case_eval_caseeval", "seats_seatbit_seatbit"], "relation": "participate_in", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/REFACTOR_process_multiway.md"}]}