{"nodes": [{"id": "docs_analysis_mental_poker", "label": "Analysis: Mental Poker (distributed serverless card games)", "file_type": "document", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_analysis_mental_poker_mental_poker", "label": "Mental Poker (trustless dealing problem)", "file_type": "concept", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates the state-coordination problem (replicated state machine over a signed hash-linked log) from the card-secrecy problem (threshold encryption + verifiable shuffles). Known unsolved pain points: the drop-out problem, settlement being separate from dealing, and collusion being unfixable by crypto."}, {"id": "docs_analysis_mental_poker_sra_mental_poker_1979", "label": "Shamir, Rivest & Adleman \u2014 Mental Poker (1979)", "file_type": "paper", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": "https://people.csail.mit.edu/rivest/pubs/SRA81.pdf", "captured_at": null, "author": "Shamir, Rivest, Adleman", "contributor": null}, {"id": "docs_analysis_mental_poker_barnett_smart_2003", "label": "Barnett & Smart \u2014 Mental Poker Revisited (2003)", "file_type": "paper", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": "https://doi.org/10.1007/978-3-540-40974-8_29", "captured_at": null, "author": "Barnett, Smart", "contributor": null}, {"id": "docs_analysis_mental_poker_kaleidoscope", "label": "Kaleidoscope / ROYALE \u2014 poker with payment and penalty enforcement", "file_type": "paper", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": "https://eprint.iacr.org/2017/899", "captured_at": null, "author": "David, Dowsley, Larangeira", "contributor": null, "rationale": "Addresses the two gaps mental poker alone leaves open: real-money settlement and the dropout/penalty problem, via blockchain escrow and slashing."}, {"id": "docs_analysis_mental_poker_vtmf", "label": "VTMF (verifiable l-out-of-l threshold masking function)", "file_type": "concept", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Barnett-Smart's core abstraction: threshold ElGamal exposing keygen/mask/remask/unmask; staged unmasking implements reveal-to-one (hole cards) vs full unmask (board/showdown) via reveal tokens with Chaum-Pedersen proofs."}, {"id": "docs_analysis_mental_poker_signed_event_log", "label": "Signed hash-linked event log (replicated state machine)", "file_type": "rationale", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State is the deterministic fold over a verifiable log; prev_hash chaining makes history tamper-evident, turn structure replaces consensus for ordering, and signatures stop impersonation. Equivocation is detectable but only prevented with a broadcast layer."}, {"id": "docs_analysis_mental_poker_cardcrypto_trait", "label": "CardCrypto trait (swappable mental-poker crypto seam)", "file_type": "concept", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design seam: pkcore's engine only ever sees plaintext Cards and DealerActions; all crypto is verified at the node boundary. A PlaintextCrypto mock proves the integration before swapping in BayerGrothCrypto with zero engine changes."}, {"id": "docs_analysis_mental_poker_coordinator_trait", "label": "Coordinator trait (transport/ordering seam)", "file_type": "concept", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only thing that differs across the six deployment architectures (in-process, P2P mesh, relay, semi-trusted coordinator, state channel, fully on-chain): each becomes one Coordinator impl with publish/next_event/head."}, {"id": "docs_analysis_mental_poker_pkcore_mp", "label": "pkcore-mp crate skeleton (mental poker layer for pkcore)", "file_type": "concept", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_analysis_mental_poker_qr_transport", "label": "QR codes as state sync beacon / offline transport", "file_type": "concept", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QR fits sync pointers, per-turn deltas, and signed checkpoints (~under 1.5KB practical limit) but not the masked deck or shuffle proofs, which need animated fountain-coded QR (BC-UR style). A QR shown to the whole table is a physical broadcast that attacks equivocation."}, {"id": "docs_analysis_mental_poker_gamerules_trait", "label": "GameRules trait (generic card-game engine abstraction)", "file_type": "concept", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Don't unify on a Game object \u2014 poker, Go Fish, and trick-taking share no honest shape there. Unify one level lower on a card-operations-over-zones algebra plus a zone/visibility model; view_for is the hidden-information projection and the seam the crypto layer plugs into."}, {"id": "docs_analysis_mental_poker_tricktaking", "label": "tricktaking crate (trick-taking family layer for bridge/spades)", "file_type": "concept", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": "https://github.com/ImperialBower/tricktaking", "captured_at": null, "author": null, "contributor": null, "rationale": "Family mid-layer owning trick state, follow-suit legality, and trump resolution (~70-80% of trick-taking games), exposing only trump/can_play/score hooks so bridge and spades stay thin; the auction is deliberately not modeled because bidding is where per-game volume lives."}, {"id": "docs_analysis_mental_poker_geometry_mental_poker", "label": "geometryxyz/mental-poker (Rust Barnett-Smart implementation)", "file_type": "concept", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": "https://github.com/geometryxyz/mental-poker", "captured_at": null, "author": null, "contributor": null}, {"id": "docs_analysis_mental_poker", "label": "ANALYSIS: Mental Poker", "file_type": "document", "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_analysis_mental_poker", "target": "docs_analysis_mental_poker_sra_mental_poker_1979", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "weight": 1.0}, {"source": "docs_analysis_mental_poker", "target": "docs_analysis_mental_poker_barnett_smart_2003", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "weight": 1.0}, {"source": "docs_analysis_mental_poker", "target": "docs_analysis_mental_poker_kaleidoscope", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANALYSIS_Mental_Poker.md", "source_location": null, "weight": 1.0}, {"source": "docs_analysis_mental_poker", "target": "docs_analysis_mental_poker_mental_poker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANALYSIS_Menta