{"nodes": [{"id": "docs_epic_15_gto_solver", "label": "EPIC-15: GTO Solver", "file_type": "document", "source_file": "docs/EPIC-15_GTO_Solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epic_15_gto_solver_cfr", "label": "Counterfactual Regret Minimization (CFR)", "file_type": "concept", "source_file": "docs/EPIC-15_GTO_Solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Regret = how much you regret not taking a different action; counterfactual = weighted by the probability of reaching the decision given the opponent's strategy; minimization via regret-matching. Key theorem: in two-player zero-sum games, if both players minimize regret independently, the average strategy across iterations converges to a Nash equilibrium \u2014 you play the running average, not the current iteration."}, {"id": "docs_epic_15_gto_solver_nash_equilibrium", "label": "Nash Equilibrium", "file_type": "concept", "source_file": "docs/EPIC-15_GTO_Solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epic_15_gto_solver_exploitability", "label": "Exploitability Metric", "file_type": "concept", "source_file": "docs/EPIC-15_GTO_Solver.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chips/100 hands a strategy loses to the best-response opponent; Nash equilibrium has exploitability 0, practical solvers target < 0.1 chips/100. True computation needs a separate best-response tree pass."}], "edges": [{"source": "docs_epic_15_gto_solver", "target": "docs_epic_14_equity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/EPIC-15_GTO_Solver.md", "source_location": null, "weight": 1.0}, {"source": "docs_epic_15_gto_solver", "target": "docs_epic_15_gto_solver_c