{"nodes": [{"id": "docs_epic_13_variants", "label": "EPIC-13: Poker Variants", "file_type": "document", "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_epic_13_variants_omaha_hi_lo", "label": "Omaha Hi-Lo (8 or Better)", "file_type": "concept", "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pot split between best high and best qualifying low (five unpaired cards 8 or lower, ace plays low). High and low are ranked independently per hole-card combination, so all 60 permutations iterate twice. Pot-splitting belongs in the dealer/game layer, not hand ranking."}, {"id": "docs_epic_13_variants_razz", "label": "Razz Variant", "file_type": "concept", "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seven-Card Stud played for A-5 low with no qualifier. CaliforniaHandRank already enumerates all valid Razz hands; remaining work is a RazzHand struct doing the C(7,5)=21 minimum search. Suggested first variant to implement."}, {"id": "docs_epic_13_variants_limit_holdem", "label": "Limit Hold'em Variant", "file_type": "concept", "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand ranking identical to NLHE; the difference is entirely betting structure (fixed small/big bets, 4-raise cap per street). Primarily a pkdealer concern; pkcore only needs the BettingStructure type."}, {"id": "docs_epic_13_variants_seven_card_stud", "label": "Seven-Card Stud Variant", "file_type": "concept", "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hand ranking reuses the existing Seven C(7,5) machinery; the hard part is the street model (bring-in, per-player up-cards, action order by best visible hand) which doesn't fit the Hold'em-centric Board type."}, {"id": "docs_epic_13_variants_stud_hi_lo", "label": "Stud Hi-Lo (Eight or Better)", "file_type": "concept", "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Largely composition once StudHand and RazzHand exist: rank high with StudHand, low with RazzHand, return (Eval, Option<LowEval>). Implement last \u2014 most complex, depends on everything above."}, {"id": "docs_epic_13_variants_bettingstructure", "label": "BettingStructure Enum (proposed)", "file_type": "concept", "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proposed enum NoLimit / PotLimit / FixedLimit { small_bet, big_bet } extending ForcedBets, needed for Limit Hold'em and useful for Pot-Limit Omaha."}], "edges": [{"source": "docs_epic_13_variants", "target": "games_omaha_omahahigh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "weight": 1.0}, {"source": "docs_epic_13_variants", "target": "razz_california_californiahandrank", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "weight": 1.0}, {"source": "docs_epic_13_variants", "target": "docs_epic_13_variants_omaha_hi_lo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/EPIC-13_Variants.md", "source_location": null, "weight": 1.0}, {"source": "docs_epic_13_variants", "target": "docs_epic_13_variants_razz", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_