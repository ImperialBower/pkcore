{"nodes": [{"id": "docs_release_0_0_55", "label": "pkcore 0.0.55 Release Notes", "file_type": "document", "source_file": "docs/RELEASE_0.0.55.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_release_0_0_55_short_blind_call_target_revert", "label": "Short-Blind Call Target Revert (TDA Rule 41)", "file_type": "rationale", "source_file": "docs/RELEASE_0.0.55.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reverts the 0.0.48 non-standard interpretation: when the BB posts all-in short, to_call() now returns the configured BB (standard rules, TDA Rule 41) rather than the actual posted amount; side-pot stratification and uncalled-bet returns preserve chip conservation. act_call auto-converts under-stack callers to partial all-in instead of erroring. Audit heuristic captured: never conflate 'what-actually-happened' fields (event log payload) with 'what-the-rules-require' fields (table-level call target) \u2014 each consumer of a capped 'actual' value must pull from the right source."}], "edges": [{"source": "docs_release_0_0_55", "target": "docs_release_0_0_55_short_blind_call_target_revert", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE_0.0.55.md", "source_location": null, "weight": 1.0}, {"source": "docs_release_0_0_55_short_blind_call_target_revert", "target": "casino_table_no_cell_tablenocell", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE_0.0.55.md", "source_location": "act_forced_bet_big_blind / to_call / act_call", "weight": 1.0}, {"source": "docs_release_0_0_55_short_blind_call_target_revert", "target": "casino_table_tablecelled", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/RELEASE_0.0.55.md", "source_location": "same revert in Cell-based pat