{"nodes": [{"id": "docs_analysis_table_vs_tablenocell", "label": "Analysis: TableCelled vs TableNoCell (interior mutability vs &mut self)", "file_type": "document", "source_file": "docs/ANALYSIS_Table_vs_TableNoCell.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_analysis_table_vs_tablenocell_interior_mutability", "label": "Interior mutability pattern (Cell/RefCell &self mutation)", "file_type": "rationale", "source_file": "docs/ANALYSIS_Table_vs_TableNoCell.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TableCelled wraps every mutable field in Cell/RefCell so all methods take &self, enabling shared-reference observers and free-function showdown, at the cost of runtime double-borrow panics, RefCell counter overhead on hot paths, and borrow-scope discipline by convention rather than compiler enforcement. Neither design is thread-safe (Cell/RefCell are !Sync). For the single-controller game loop, TableNoCell is the cleaner design."}], "edges": [{"source": "docs_analysis_table_vs_tablenocell", "target": "casino_table_tablecelled", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANALYSIS_Table_vs_TableNoCell.md", "source_location": null, "weight": 1.0}, {"source": "docs_analysis_table_vs_tablenocell", "target": "casino_table_no_cell_tablenocell", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANALYSIS_Table_vs_TableNoCell.md", "source_location": null, "weight": 1.0}, {"source": "docs_analysis_table_vs_tablenocell", "target": "table_showdown_showdown", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ANALYSIS_Table_vs_TableNoCell.md", "source_location": null, "weight": 1.0}, {"source": "docs_analysis_table_vs_tablenocell", "target": "casino_table_tablelog", "relation": "refe