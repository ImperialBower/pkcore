{"nodes": [{"id": "docs_tutorial_epic28_es_math", "label": "TUTORIAL: EPIC-28 Evolution Strategy Math", "file_type": "document", "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tutorial_epic28_es_math", "label": "EPIC-28 Math Tutorial: Evolution Strategies and Noisy Optimisation", "file_type": "document", "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_tutorial_epic28_es_math_one_plus_lambda_es", "label": "(1+lambda) Evolution Strategy", "file_type": "rationale", "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": "section 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over CMA-ES as a deliberate trade-off: full correctness with zero new crate dependencies (the cmaes crate would pull in nalgebra) over theoretical convergence speed. For n=16 bounded, moderately noisy parameters, isotropic mutation with the 1/5 rule converges comparably to CMA-ES."}, {"id": "docs_tutorial_epic28_es_math_one_fifth_success_rule", "label": "Rechenberg 1/5 Success Rule (step-size adaptation)", "file_type": "rationale", "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": "section 4", "source_url": null, "captured_at": null, "author": "Rechenberg (1973)", "contributor": null, "rationale": "Target success probability of 1/5 derives from Rechenberg's analysis of (1+1)-ES on a sphere function: optimal progress at p_s ~ 1/(2e) ~ 18.4%. Constants c+=1.22, c-=0.90 approximately satisfy the self-consistency condition c-^4 ~ c+^-1."}, {"id": "docs_tutorial_epic28_es_math_box_muller_transform", "label": "Box-Muller Transform (Gaussian sampling)", "file_type": "rationale", "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": "section 5", "source_url": "https://en.wikipedia.org/wiki/Box%E2%80%93Muller_transform", "captured_at": null, "author": "Box & Muller (1958)", "contributor": null, "rationale": "Basic form used (discarding Z_1) is wasteful by a factor of two but keeps code trivial; U_1 is clamped to f64::MIN_POSITIVE to avoid ln(0)."}, {"id": "docs_tutorial_epic28_es_math_cma_es", "label": "CMA-ES (Covariance Matrix Adaptation Evolution Strategy)", "file_type": "concept", "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": "section 9", "source_url": "https://arxiv.org/abs/1604.00772", "captured_at": null, "author": "Hansen & Ostermeier (2001)", "contributor": null}, {"id": "docs_tutorial_epic28_es_math_bb_per_100", "label": "BB/100 fitness metric", "file_type": "rationale", "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": "section 7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standard poker win-rate metric used as the stochastic objective for exploit training. Evaluator uses 1000 BB deep stacks (STARTING_CHIPS = BB * 1000) because the earlier 1B-chip design produced BB/100 values in the millions, swamping all signal; 3 replicates x 8 opponents reduce standard error ~4.9x."}], "edges": [{"source": "docs_tutorial_epic28_es_math", "target": "training_trainer_exploittrainer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": "intro", "weight": 1.0}, {"source": "docs_tutorial_epic28_es_math", "target": "bot_exploit_exploitconfig", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": "section 1", "weight": 1.0}, {"source": "docs_tutorial_epic28_es_math", "target": "training_trainer_standard_normal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/TUTORIAL_EPIC28_ES_Math.md", "source_location": "section 